{
  "name": "rollup-plugin-oxc-transform",
  "version": "0.0.3",
  "description": "Rollup plugin used to transpile JavaScript/TypeScript code with oxc",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^20 || ^22 || ^24"
  },
  "module": "./dist/index.mjs",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    "types": "./dist/index.d.ts",
    "import": "./dist/index.mjs",
    "default": "./dist/index.cjs"
  },
  "homepage": "https://github.com/marcalexiei/rollup-plugin-oxc-transform/",
  "bugs": {
    "url": "https://github.com/marcalexiei/rollup-plugin-oxc-transform/issues"
  },
  "keywords": [
    "rollup",
    "plugin",
    "oxc",
    "npm",
    "modules"
  ],
  "files": [
    "dist"
  ],
  "author": "Marco Pasqualetti @marcalexiei",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/marcalexiei/rollup-plugin-oxc-transform.git"
  },
  "scripts": {
    "prepare": "husky",
    "build": "rollup -c",
    "typecheck": "tsc --noEmit",
    "test": "ava",
    "format": "prettier . --check",
    "format:fix": "prettier . --write",
    "lint": "eslint .",
    "lint:fix": "pnpm run lint -- --fix",
    "release": "pnpm run build && changeset publish",
    "check-all": "pnpm run \"/^(lint|format|test|typecheck|build)$/\""
  },
  "peerDependencies": {
    "oxc-resolver": "^11.0.0",
    "oxc-transform": "^0.30.5",
    "rollup": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "rollup": {
      "optional": true
    }
  },
  "dependencies": {
    "@rollup/pluginutils": "^5.3.0"
  },
  "devDependencies": {
    "@ava/typescript": "6.0.0",
    "@changesets/changelog-github": "0.5.1",
    "@changesets/cli": "2.29.7",
    "@commitlint/cli": "20.1.0",
    "@commitlint/config-conventional": "20.0.0",
    "@eslint/js": "9.37.0",
    "@marcalexiei/prettier-config": "1.1.4",
    "@rollup/plugin-typescript": "12.1.4",
    "@types/node": "24.7.2",
    "ava": "6.4.1",
    "eslint": "9.37.0",
    "husky": "9.1.7",
    "oxc-resolver": "11.9.0",
    "oxc-transform": "0.94.0",
    "prettier": "3.6.2",
    "rollup": "4.52.4",
    "tslib": "2.8.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.1"
  },
  "packageManager": "pnpm@10.18.2+sha512.9fb969fa749b3ade6035e0f109f0b8a60b5d08a1a87fdf72e337da90dcc93336e2280ca4e44f2358a649b83c17959e9993e777c2080879f3801e6f0d999ad3dd",
  "prettier": "@marcalexiei/prettier-config",
  "ava": {
    "files": [
      "./tests/*.spec.ts",
      "!./tests/types.spec.ts"
    ],
    "snapshotDir": "./tests/__snapshots/",
    "typescript": {
      "compile": "tsc",
      "rewritePaths": {
        "src/": "dist-test/src/",
        "tests/": "dist-test/tests/"
      }
    }
  }
}
